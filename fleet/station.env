# fleet/station.env — per-workstation config. Sourced by nightly.sh / postrun.sh / install_cron.sh.
# On a new machine you normally only edit STATION, REPO, and the window;
# APP_DIR / DATA_DIR auto-derive from this file's location.

# --- identity (unique per workstation: st01, st02, ...) ---
STATION=st01

# --- paths ---
APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"   # repo root = parent of fleet/ (auto)
DATA_DIR="$APP_DIR/data"                                     # recordings staging (auto)

# --- upload target (v2: direct SDK upload, no git clone) ---
REPO_ID="${REPO_ID:-SISU_DynCogLab/douyin}"   # the ModelScope dataset (owner/name); env-overridable
# ModelScope token, one of:
#   export MODELSCOPE_API_TOKEN=...            (recommended; e.g. in ~/.bashrc), OR
#   MS_TOKEN_FROM=/path/to/any/git/clone       (reads oauth2 token from its remote URL)
MS_TOKEN_FROM="${MS_TOKEN_FROM:-}"
# MS_PY="$APP_DIR/.venv-asr/bin/python"        # python that has `modelscope` (auto-detected)

# --- upload stagger (offset stations so they don't all push to ModelScope at once) ---
# Set ONE of these, unique per station. UPLOAD_AT wins if both are set.
UPLOAD_AT="${UPLOAD_AT:-}"          # fixed clock time to upload, e.g. st01=22:30 st02=23:00 st03=23:30 ...
UPLOAD_DELAY="${UPLOAD_DELAY:-0}"   # OR seconds to wait after recording, e.g. st01=0 st02=1800 st03=3600 ...

# --- nightly window ---
START_AT=20:00        # HH:MM local time to begin
MINUTES=120           # window length in minutes (120 = 2h)

# --- transcription (SenseVoice-Small, CPU, in postrun) ---
# Provision once per station:  .venv-asr with `funasr` + CPU `torch`/`torchaudio`
#   .venv-asr/bin/pip install torch torchaudio --index-url https://download.pytorch.org/whl/cpu
# First run caches SenseVoice-Small (~900MB) + fsmn-vad (~2MB) under ~/.cache/modelscope.
ASR_JOBS=1           # parallel rooms; 1 is plenty (one model ~30x realtime, saturates the CPU)

# --- packing ---
SHARD_GB=7            # max video shard size (keep <= 7)

# --- safety ---
DISK_FLOOR_GB=40      # abort start / warn if free space below this
